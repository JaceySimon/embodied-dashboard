# 具身智能看板 - 环境变量示例
# 复制这个文件为 .env，然后填入你的 API key

# DeepSeek API（打标用）
LLM_PROVIDER=deepseek
LLM_API_KEY=your_deepseek_api_key_here

# X API（等审核通过后填）
# X_BEARER_TOKEN=your_x_bearer_token_here

# GitHub Token（可选，用于开源动态采集；未认证 60 次/小时，配置后 5000 次/小时）
# 免费创建：GitHub Settings → Developer settings → Personal access tokens → Tokens (classic)
# → Generate new token，无需勾选任何权限（public 仓库读取用），复制填入
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# Hugging Face Token（可选，用于模型权重采集；无 token 也能采白名单机构）
# 免费创建：HF 网站 → Settings → Access Tokens → Read 权限即可
# HF_TOKEN=hf_xxxxxxxxxxxxxxxx
